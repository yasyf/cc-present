{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan.machine",
  "type": "object",
  "required": ["id", "type", "states", "transitions"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "plan.machine" },
    "title": { "$ref": "#/$defs/line" },
    "caption": { "type": "string", "minLength": 1 },
    "initial": { "$ref": "#/$defs/stateId" },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/stateId" },
          "label": { "$ref": "#/$defs/line" },
          "note": { "type": "string", "minLength": 1 },
          "final": { "type": "boolean" },
          "mark": { "enum": ["+", "-", "~"] },
          "screen": {
            "oneOf": [
              {
                "type": "object",
                "required": ["md"],
                "additionalProperties": false,
                "properties": { "md": { "type": "string", "minLength": 1, "maxLength": 65536 } }
              },
              {
                "type": "object",
                "required": ["mock"],
                "additionalProperties": false,
                "properties": { "mock": { "$ref": "#/$defs/mock" } }
              }
            ]
          }
        }
      }
    },
    "grid": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": { "anyOf": [{ "$ref": "#/$defs/stateId" }, { "type": "null" }] }
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["from", "event", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "$ref": "#/$defs/stateId" },
          "event": { "$ref": "#/$defs/line" },
          "to": { "$ref": "#/$defs/stateId" },
          "label": { "$ref": "#/$defs/line" },
          "mark": { "enum": ["+", "-", "~", "?"] }
        }
      }
    }
  },
  "$defs": {
    "line": { "type": "string", "minLength": 1, "pattern": "^[^\\n]*$" },
    "stateId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 40 },
    "mock": {
      "type": "object",
      "required": ["html"],
      "additionalProperties": false,
      "properties": {
        "html": { "type": "string", "minLength": 1, "maxLength": 131072 },
        "css": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "w": { "type": "integer", "minimum": 200, "maximum": 1600, "default": 480 },
        "h": { "type": "integer", "minimum": 60, "maximum": 4000 },
        "frame": { "enum": ["none", "browser", "phone", "desktop", "terminal"], "default": "none" },
        "url": { "$ref": "#/$defs/line" },
        "title": { "$ref": "#/$defs/line" }
      }
    }
  }
}
