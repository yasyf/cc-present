{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "display.compare",
  "type": "object",
  "required": ["id", "type", "columns", "rows"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "display.compare" },
    "title": { "$ref": "#/$defs/line" },
    "caption": { "type": "string", "minLength": 1 },
    "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["label"],
        "additionalProperties": false,
        "properties": {
          "label": { "$ref": "#/$defs/line" },
          "sub": { "$ref": "#/$defs/line" },
          "highlight": { "type": "boolean" }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["label", "cells"],
        "additionalProperties": false,
        "properties": {
          "label": { "$ref": "#/$defs/line" },
          "hint": { "$ref": "#/$defs/line" },
          "cells": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["md"],
                  "additionalProperties": false,
                  "properties": {
                    "md": { "type": "string" },
                    "tone": { "enum": ["good", "bad", "warn", "neutral"] }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "line": { "type": "string", "minLength": 1, "pattern": "^[^\\n]*$" }
  }
}
