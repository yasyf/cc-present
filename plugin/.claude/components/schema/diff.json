{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pr.diff",
  "type": "object",
  "required": ["id", "type", "patch"],
  "additionalProperties": false,
  "dependentRequired": { "repo": ["number"], "number": ["repo"] },
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "pr.diff" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "number": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "note": { "type": "string", "minLength": 1 },
    "paths": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "minLength": 1 } },
    "match": { "type": "string", "minLength": 1 },
    "max_lines": { "type": "integer", "minimum": 5, "maximum": 400, "default": 60 },
    "patch": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "fetched_at": { "type": "string", "format": "date-time" }
  }
}
